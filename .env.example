# Persistent data on Babel. Must be a direct pool path (not /mnt/user).
DATA_DIR=/mnt/cache/appdata/claude-remote

# Secrets and identity: set in Dockhand's stack environment, never commit.
# Single account:
GH_TOKEN=
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com
# Several accounts: ';'-separated host[/owner-or-group]=token, longest prefix wins, falls back to the above.
#   GIT_TOKENS=github.com/acme=ghp_xxx;github.com=ghp_yyy;git.example.com=glpat_zzz
GIT_TOKENS=
# Commit identity: default, plus optional per-prefix overrides (same prefix rules).
#   GIT_IDENTITIES=github.com/acme=Jane Doe <jane@acme.example>
GIT_NAME=
GIT_EMAIL=
GIT_IDENTITIES=

# Claude permission mode for Remote Control and CLI sessions:
# default | acceptEdits | plan | auto | dontAsk | bypassPermissions (invalid → default)
PERMISSION_MODE=auto

# Remote Control
RC_NAME=Babel
RC_CAPACITY=3
RC_SPAWN=

# SSH for JetBrains Gateway / VS Code Remote-SSH (key-only).
# Keys separated by ';' or newlines; URLs (space/';' separated) are fetched at start, e.g. https://github.com/<user>.keys
ENABLE_SSH=false
SSH_AUTHORIZED_KEYS=
SSH_AUTHORIZED_KEYS_URL=
SSH_PORT=2222

# Images (built weekly by GitHub Actions). Pin IMAGE_TAG to a date tag (YYYY-MM-DD) to roll back.
IMAGE_REGISTRY=ghcr.io/pentacore
IMAGE_TAG=latest

# One-time seeding of Playwright + Context7 MCP and superpowers + mattpocock-skills plugins
CLAUDE_SEED=true
# Optional: higher Context7 rate limits
CONTEXT7_API_KEY=

# Docker-in-Docker
DOCKER_MAJOR=29
DIND_SIZE_GB=100
PORT_RANGE=18000-18099

# Janitor (minutes / percent of Docker storage)
JANITOR_IDLE_MIN=120
JANITOR_MAX_AGE_MIN=1440
JANITOR_UNTAGGED_MAX_AGE_MIN=60
JANITOR_MARKER_MAX_AGE_MIN=10080
JANITOR_SOFT_PCT=75
JANITOR_HARD_PCT=90

# Resources and housekeeping
CLAUDE_CPUS=4
CLAUDE_MEM=12g
DIND_CPUS=6
DIND_MEM=14g
CACHE_MAX_GB=20
IDE_KEEP_VERSIONS=2
TZ=Europe/Stockholm
