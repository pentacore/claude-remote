#!/usr/bin/env bash
# git credential helper: picks a token for host/path via tokens.sh. Read-only (store/erase are no-ops).
[[ ${1:-} == get ]] || exit 0
. "${CLAUDE_REMOTE_LIB:-/usr/local/lib/claude-remote}/tokens.sh"
host="" path=""
while IFS= read -r line && [[ -n $line ]]; do
  case $line in
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
  esac
done
tok=$(token_for "$host" "$path")
[[ -n $tok ]] || exit 0
if [[ $host == github.com ]]; then user=x-access-token; else user=oauth2; fi
printf 'username=%s\npassword=%s\n' "$user" "$tok"
