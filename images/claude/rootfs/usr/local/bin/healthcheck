#!/usr/bin/env bash
# Healthy = logged in to claude.ai and the remote-control process is running.
CLAUDE_BIN=${CLAUDE_BIN:-$HOME/.local/bin/claude}
PGREP=${PGREP:-pgrep}
if ! "$CLAUDE_BIN" auth status >/dev/null 2>&1; then
  echo "unhealthy: not logged in to claude.ai (run: claude auth login)"
  exit 1
fi
if ! "$PGREP" -f 'remote-control' >/dev/null 2>&1; then
  # last line remote-control itself printed (the rc tmux pane is logged by the supervisor)
  reason=$(tail -n 50 "${RC_LOG:-/workspace/.claude-remote/logs/remote-control.log}" 2>/dev/null |
    sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r//g' | grep -v -e '^[[:space:]]*$' -e '^rc-loop:' | tail -n 1)
  echo "unhealthy: claude remote-control is not running${reason:+: $reason}"
  exit 1
fi
echo healthy
