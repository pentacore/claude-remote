#!/usr/bin/env bash
# Runs `claude remote-control` forever; backs off when it exits quickly (e.g. not logged in).
cd /workspace || exit 1
while true; do
  started=$(date +%s)
  args=(remote-control --name "${RC_NAME:-Babel}" --capacity "${RC_CAPACITY:-3}"
        --permission-mode "${PERMISSION_MODE:-auto}")
  [[ -n ${RC_SPAWN:-} ]] && args+=(--spawn "$RC_SPAWN")
  claude "${args[@]}"
  code=$?
  if (($(date +%s) - started < 60)); then
    echo "remote-control exited ($code) within a minute; if not logged in run: claude auth login. Retrying in 60s."
    sleep 60
  else
    echo "remote-control exited ($code); restarting in 5s"
    sleep 5
  fi
done
