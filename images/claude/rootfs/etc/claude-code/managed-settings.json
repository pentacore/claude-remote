{
  "permissions": {
    "allow": [
      "Bash(git *)", "Bash(gh *)", "Bash(glab *)", "Bash(docker *)",
      "Bash(npm *)", "Bash(npx *)", "Bash(pnpm *)", "Bash(bun *)", "Bash(node *)",
      "Bash(uv *)", "Bash(python3 *)", "Bash(go *)", "Bash(cargo *)",
      "Bash(composer *)", "Bash(php *)", "Bash(make *)"
    ],
    "ask": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)", "Bash(git push * -f)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/usr/local/lib/claude-remote/hooks/session-start.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/local/lib/claude-remote/hooks/heartbeat.sh" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/usr/local/lib/claude-remote/hooks/session-end.sh" }] }
    ]
  }
}
